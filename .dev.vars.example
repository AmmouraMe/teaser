# Waitlist notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Admin login at /auth/discord (gated to ALLOWED_USER), and the Discord
# join button. One OAuth app can serve both, but register BOTH redirect URIs:
#   https://<host>/auth/discord/callback        (admin)
#   https://<host>/auth/join/discord/callback   (waitlist join)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Waitlist join buttons. Each provider's redirect URI is
#   https://<host>/auth/join/<provider>/callback
# Unset providers are not rendered, so you can add them one at a time.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Apple: APPLE_CLIENT_ID is the *Services ID*, not the App ID. The private key
# is the .p8 downloaded from the developer portal; paste its contents with
# literal \n between lines, or as a real multi-line value.
# Note Apple requires a paid Developer Program membership.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
